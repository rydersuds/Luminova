# Copy this file to .env and fill in your own values. .env is never committed.
ADMIN_PASSWORD=choose-a-strong-password
# Set to 1 when the site is served over HTTPS:
# COOKIE_SECURE=1

# Email each new booking (see "Booking emails" in README.md). Remove the # to turn on.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=the.account@gmail.com
# SMTP_PASS=the-app-password
# NOTIFY_EMAIL=info@massagecalgary.ca
# SITE_URL=https://massagecalgary.ca
